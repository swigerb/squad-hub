{
  "id": "/",
  "name": "Squad Hub",
  "short_name": "Squad Hub",
  "description": "See and control your Squad sessions across every device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14161a",
  "theme_color": "#14161a",
  "orientation": "any",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-mask-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "New session",
      "short_name": "New",
      "description": "Start a session on a connected device",
      "url": "/?shortcut=new-session",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Needs you",
      "short_name": "Needs you",
      "description": "Jump to the session waiting on an answer or an approval",
      "url": "/?shortcut=needs-you",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Start ACA job",
      "short_name": "ACA job",
      "description": "Run a Squad session in its own Azure Container Apps job",
      "url": "/?shortcut=aca-job",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "All sessions, grouped by device, with the install card open"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "All sessions on a phone"
    }
  ]
}
