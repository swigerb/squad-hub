# A0 premises 1-3, in a container that mirrors squad-on-aca's worker.
#
# NOT the real worker image. That one installs gh, az, copilot and squad-cli --
# a heavy build, and none of it is what these premises are about. What matters
# is reproducing the CONSTRAINTS the daemon would actually meet there:
#
#   - the same Node major (node:24-bookworm-slim)
#   - a non-root user called `squad`, because that is who the worker runs as
#   - /workspace as the working directory
#
# If the daemon cannot come up under those, A3 needs an image change and it is
# much cheaper to learn that now.
FROM node:24-bookworm-slim

RUN useradd --create-home --shell /bin/bash squad
WORKDIR /workspace

COPY package.json ./
COPY src ./src
COPY bin ./bin
COPY test/fake-agent.js ./test/fake-agent.js
COPY spike/container-probe.js ./spike/container-probe.js

RUN chown -R squad:squad /workspace
USER squad

ENV SQUAD_HUB_HOME=/home/squad/.squad-hub

CMD ["node", "spike/container-probe.js"]
