# Source and text fixtures must have the same bytes on Windows and Linux.
*.js text eol=lf
*.css text eol=lf
web/*.html text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

# Squad 1.0: the casting pair is verified byte-for-byte against the SHA-256 in
# registry-history.commit.json, so a CRLF checkout fails squad health.
.squad/casting/*.json text eol=lf
